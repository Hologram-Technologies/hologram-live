{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hologram",
  "version": "1.0.0",
  "identifier": "dev.hologram.live.desktop",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hologram",
        "width": 820,
        "height": 620,
        "minWidth": 560,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/hologram"]
  }
}
