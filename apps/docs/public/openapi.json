  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "AppendMessageRequest": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "content": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "ApplicationCompletion": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "unknown"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "returned"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "code",
              "kind"
            ],
            "properties": {
              "code": {
                "type": "integer",
                "format": "int32"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "exited"
                ]
              }
            }
          }
        ]
      },
      "ArchiveConversationRequest": {
        "type": "object",
        "required": [
          "archived"
        ],
        "properties": {
          "archived": {
            "type": "boolean"
          }
        }
      },
      "CapabilityManifest": {
        "type": "object",
        "required": [
          "protocol_version",
          "server_version",
          "server_id",
          "role",
          "operations",
          "modules",
          "maximum_message_bytes"
        ],
        "properties": {
          "maximum_message_bytes": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "modules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModuleInfo"
            }
          },
          "operations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OperationInfo"
            }
          },
          "protocol_version": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "role": {
            "type": "string"
          },
          "server_id": {
            "type": "string"
          },
          "server_version": {
            "type": "string"
          }
        }
      },
      "ChatRequest": {
        "type": "object",
        "required": [
          "content"
        ],
        "properties": {
          "content": {
            "type": "string"
          }
        }
      },
      "Conversation": {
        "type": "object",
        "required": [
          "id",
          "title",
          "created_at_millis",
          "updated_at_millis",
          "messages"
        ],
        "properties": {
          "archived": {
            "type": "boolean",
            "description": "Defaulted so conversations written before archiving existed still load."
          },
          "created_at_millis": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "id": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConversationMessage"
            }
          },
          "title": {
            "type": "string"
          },
          "updated_at_millis": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "ConversationMessage": {
        "type": "object",
        "required": [
          "role",
          "content",
          "created_at_millis"
        ],
        "properties": {
          "content": {
            "type": "string"
          },
          "created_at_millis": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "role": {
            "type": "string"
          }
        }
      },
      "CreateConversationRequest": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "version",
          "role",
          "modules_ready"
        ],
        "properties": {
          "modules_ready": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "HoloBlob": {
        "type": "object",
        "description": "One content-addressed blob physically embedded in a fat `.holo`.",
        "required": [
          "kappa",
          "byte_length"
        ],
        "properties": {
          "byte_length": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "kappa": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "HoloChild": {
        "type": "object",
        "description": "One composed child application and its attenuated capability set.",
        "required": [
          "position",
          "application_kappa",
          "capabilities_kappa"
        ],
        "properties": {
          "application_kappa": {
            "type": "string"
          },
          "application_resolution_source": {
            "type": [
              "string",
              "null"
            ]
          },
          "capabilities_kappa": {
            "type": "string"
          },
          "capabilities_resolution_source": {
            "type": [
              "string",
              "null"
            ]
          },
          "depth": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "parent_application_kappa": {
            "type": [
              "string",
              "null"
            ]
          },
          "position": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "requires_kappa": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "HoloDirectory": {
        "type": "object",
        "description": "A normalized, versioned projection of an application manifest and its\nphysical packaging. Layers refer to blobs by kappa instead of nesting them.",
        "required": [
          "schema_version",
          "requires_kappa",
          "layers",
          "children",
          "blobs"
        ],
        "properties": {
          "blobs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HoloBlob"
            }
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HoloChild"
            }
          },
          "layers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HoloLayer"
            }
          },
          "primary_layer": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "requires_kappa": {
            "type": "string"
          },
          "schema_version": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "HoloInspection": {
        "type": "object",
        "required": [
          "kappa",
          "name",
          "format_version",
          "byte_length",
          "archive_fingerprint",
          "footer_verified",
          "sections",
          "directory_embedded"
        ],
        "properties": {
          "application_kappa": {
            "type": [
              "string",
              "null"
            ],
            "description": "Canonical application-manifest kappa, absent for structural archives\nthat do not contain an application manifest."
