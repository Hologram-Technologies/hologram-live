---
import '../styles/global.css';
import { sitePath, withoutBase } from '../lib/site';

const {
  title,
  description = 'Documentation for the local-first, remote-capable Hologram module host.',
} = Astro.props;
const pathname = withoutBase(Astro.url.pathname);
const pageTitle = title === 'Hologram Live' ? title : `${title} · Hologram Live`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0d0f" />
    <title>{pageTitle}</title>
    <script is:inline>
      // Dark is the default look; light applies only when the reader opts in.
      const savedTheme = localStorage.getItem('hologram-theme');
      document.documentElement.dataset.theme = savedTheme ?? 'dark';
    </script>
  </head>
  <body>
    <div class="site-glow" aria-hidden="true"></div>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={sitePath('/')} aria-label="Hologram Live home">
          <span class="brand-mark" aria-hidden="true"><span></span></span>
          <span>Hologram <strong>Live</strong></span>
        </a>
        <nav class="top-nav" aria-label="Primary navigation">
          <a class:list={[{ active: pathname.startsWith('/docs') }]} href={sitePath('/docs/getting-started')}>Docs</a>
          <a href={sitePath('/docs/api-reference')}>API</a>
          <a href={sitePath('/docs/architecture')}>Architecture</a>
        </nav>
        <div class="header-actions">
          <a class="api-pill" href="http://127.0.0.1:11435/docs">Open local API <span>↗</span></a>
          <button class="theme-toggle" type="button" aria-label="Toggle color theme">
            <span class="theme-sun">☼</span><span class="theme-moon">◐</span>
          </button>
        </div>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div>
        <a class="brand footer-brand" href={sitePath('/')}><span class="brand-mark"><span></span></span> Hologram Live</a>
        <p>A local-first module host with explicit boundaries.</p>
      </div>
      <div class="footer-links">
        <a href={sitePath('/docs/getting-started')}>Documentation</a>
        <a href={sitePath('/docs/api-reference')}>API reference</a>
        <a href={sitePath('/docs/security')}>Security</a>
      </div>
    </footer>
    <script is:inline>
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('hologram-theme', next);
      });
    </script>
  </body>
</html>
