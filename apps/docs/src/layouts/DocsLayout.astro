---
import Base from './Base.astro';

const { title, description } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '');
const navigation = [
  {
    label: 'Start here',
    links: [
      ['/docs/getting-started', 'Getting started'],
      ['/docs/cli', 'Command line'],
      ['/docs/configuration', 'Configuration'],
    ],
  },
  {
    label: 'Build and operate',
    links: [
      ['/docs/architecture', 'Architecture'],
      ['/docs/modules', 'Modules'],
      ['/docs/telemetry', 'Telemetry'],
      ['/docs/desktop', 'Desktop application'],
      ['/docs/security', 'Security'],
    ],
  },
  {
    label: 'Reference',
    links: [['/docs/api-reference', 'API reference']],
  },
];
---
<Base title={title} description={description}>
  <div class="docs-frame">
    <aside class="docs-sidebar">
      <div class="sidebar-label">Documentation</div>
      <nav aria-label="Documentation navigation">
        {navigation.map((group) => (
          <section class="sidebar-group">
            <h2>{group.label}</h2>
            {group.links.map(([href, label]) => (
              <a class:list={[{ active: pathname === href }]} href={href}>{label}</a>
            ))}
          </section>
        ))}
      </nav>
      <div class="sidebar-callout">
        <span class="status-dot"></span>
        <div><strong>Local daemon</strong><span>127.0.0.1:11435</span></div>
      </div>
    </aside>
    <article class="doc-content">
      <div class="breadcrumb"><a href="/docs/getting-started">Docs</a><span>/</span><span>{title}</span></div>
      <slot />
      <div class="doc-next">
        <span>Need the wire contract?</span>
        <a href="/docs/api-reference">Explore the API reference <span>→</span></a>
      </div>
    </article>
  </div>
</Base>
