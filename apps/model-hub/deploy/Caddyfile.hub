gethologram.ai, gethologram.ai {
	# The Hugging Face dialect (HF_ENDPOINT=https://gethologram.ai). Clients send the user's Hugging Face token to
	# whatever HF_ENDPOINT names: it is removed here, before anything of ours can see or log it.
	@hf path_regexp hf ^(/via/[a-z.]+)?(/api/models(/|$)|/api/hub/health$|/mcp$|/[^/]+/[^/]+/resolve/|/[^/]+/[^/]+?(\.git)?/info/lfs/objects/batch$|/api/v1/models/[^/]+/[^/]+(/repo|/repo/files|/revisions)?$|/api/v1/repos/internalAccelerationInfo$)
	# Ollama's registry dialect: `ollama pull gethologram.ai/<org>/<name>:<quant>`. The hub's own OCI registry keeps
	# its namespace, model-hub; every other /v2/<org>/<name>/ is a model answered by hub-resolve.
	@ollama {
		path_regexp ollama ^/v2/[^/]+/[^/]+/(manifests|blobs|tags)/
		not path /v2/model-hub/*
	}
	handle @ollama {
		request_header -Authorization
		reverse_proxy hub-resolve:8090
	}
	# The κ mirror: `crane pull hub.uor.foundation/docker.io/library/nginx@sha256:…`. The first path component is
	# the upstream registry's host, so these names never collide with a model or with the hub's own namespaces.
	@kappa path_regexp kappa ^/v2/[a-z0-9-]+(\.[a-z0-9-]+)+/.+/(manifests|blobs|tags|referrers)/
	handle @kappa {
		request_header -Authorization
		reverse_proxy hub-resolve:8090
	}

	handle @hf {
		request_header -Authorization
		request_header -Cookie
		reverse_proxy hub-resolve:8090
	}

	encode zstd gzip

	# Baseline hardening on every answer from this site. HSTS closes the downgrade window
	# the plaintext 308 opens; nosniff stops MIME sniffing; frame-ancestors 'self' keeps
	# foreign sites from framing the hub while the Spaces stage embeds its own sealed frames.
	# Applied to the live front Caddy 2026-09-25 (backup: Caddyfile.bak-security-20260925T140334Z).
	# The front Caddy mounts this file read-only: a changed file is applied by restarting the
	# container, never by caddy reload -- a renamed file is a new inode the mount never sees.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "frame-ancestors 'self'"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# ⚠ The live host has moved past this block and it has not been reconciled: there, /v2 goes to hub-registry
	# (Hologram Registry 1.0.0) with `basic_auth` as user `publisher` rather than a bearer token, and /_* is a
	# separate handler still pointing at kappa for the days published before the switch. Diff the running
	# Caddyfile before changing anything here. Recorded 2026-09-24 while testing the write paths.
	@registry path /v2 /v2/* /_*
	handle @registry {
		@write {
			not method GET HEAD OPTIONS
			not header Authorization "Bearer {$HUB_REGISTRY_TOKEN}"
		}
		respond @write "write requires a registry token" 401
		reverse_proxy hub-kappa:5000
	}

	@preflight {
		method OPTIONS
		path /api/v1/*
	}
	handle @preflight {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, HEAD, POST, OPTIONS"
		header Access-Control-Allow-Headers "Authorization, Content-Type, X-Hologram-Kind, X-Hologram-Filename"
		header Access-Control-Max-Age "86400"
		respond 204
	}

	# An object is named by the hash of its bytes, so a response for one id can be cached forever.
	@object {
		method GET HEAD
		path_regexp ^/api/v1/objects/blake3:[0-9a-f]{64}$
	}
	handle @object {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Expose-Headers "ETag, Content-Disposition"
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy hub-server:11435 {
			header_up Authorization "Bearer {$HUB_SERVER_TOKEN}"
		}
	}

	# An address is blake3: and 64 hex characters. Anything else under this prefix is a client error, and it has to
	# refuse in the shape the document promises rather than falling through to the catch-all's text/plain.
	@object_malformed {
		path /api/v1/objects/*
		not path_regexp ^/api/v1/objects/blake3:[0-9a-f]{64}$
		not path /api/v1/objects/search
	}
	handle @object_malformed {
		header Content-Type "application/json"
		header Access-Control-Allow-Origin "*"
		respond `{"code":"LIVE_BAD_REQUEST","message":"an object address is blake3: followed by 64 hexadecimal characters"}` 400
	}

	@read {
		method GET HEAD
		path /healthz /docs /docs/scalar.js /api/v1/capabilities /api/v1/modules
	}
	handle @read {
		header Access-Control-Allow-Origin "*"
		header Cache-Control "public, max-age=60"
		reverse_proxy hub-server:11435 {
			header_up Authorization "Bearer {$HUB_SERVER_TOKEN}"
		}
	}

	@publish {
		method GET HEAD POST
		path /api/v1/objects /api/v1/objects/search
	}
	handle @publish {
		@denied not header Authorization "Bearer {$HUB_PUBLISH_TOKEN}"
		respond @denied "publish requires a publisher token" 401
		request_body {
			max_size 8MB
		}
		header Access-Control-Allow-Origin "*"
		reverse_proxy hub-server:11435 {
			header_up Authorization "Bearer {$HUB_SERVER_TOKEN}"
		}
	}

	# Sign-in, for people who chose to. Declared BEFORE @server_other, which 404s every other /api/ path.
	# No Access-Control-Allow-Origin: unlike every read surface here, this one answers its own origin only.
	# Authorization is NOT stripped on this route (it carries the visitor's own Privy token, not a Hugging Face one).
	@account path /api/account /api/account/*
	handle @account {
		request_body {
			max_size 16KB
		}
		reverse_proxy hub-account:8091
	}

	@server_other path /api/* /v1/* /hologram.live.v1.HologramLive/*
	handle @server_other {
		respond "not found" 404
	}

	handle {
		# One URL, three readers.
		#
		# A browser asks for text/html and gets the page. A caller that asks for JSON by name gets the descriptor.
		# Everything else -- curl, node fetch, python requests, every HTTP client an agent is actually built on, all
		# of which send `Accept: */*` -- used to get 78 KB of markup it could not use, and now gets the brief: the
		# whole hub on one screen, in the imperative, ending in something it can check for itself.
		#
		# Order matters: the JSON matcher is declared first because `Accept: application/json` also fails the html
		# test, and the descriptor is the better answer for a caller that asked for it by name.
		@agent {
			path /
			header Accept *application/json*
		}
		rewrite @agent /.well-known/model-hub.json
		@arriving {
			path /
			not header Accept *text/html*
			not header Accept *application/json*
			# Link unfurlers send */* too, and a preview of markdown is a worse card than a preview of the page.
			not header User-Agent *bot*
			not header User-Agent *Bot*
			not header User-Agent *Slack*
			not header User-Agent *Twitter*
			not header User-Agent *Discord*
			not header User-Agent *facebookexternalhit*
		}
		rewrite @arriving /agent.md
		# Three representations chosen by Accept means caches have to be told, or one caller's answer is served to
		# the next caller who asked for something else. Silent, intermittent, and invisible from here.
		header / Vary Accept
		# The front door has to be readable from another origin, or a browser-resident agent cannot start at all.
		header / Access-Control-Allow-Origin "*"
		header /agent.md Access-Control-Allow-Origin "*"
		header /.well-known/* Access-Control-Allow-Origin "*"
		header /llms.txt Access-Control-Allow-Origin "*"
		# One document, two paths: an agent handed nothing but the host name looks under /.well-known first.
		rewrite /.well-known/openapi.json /openapi.json
		# The whole endpoint in one OpenAPI document, built with the site. A browser agent reads it cross-origin.
		header /openapi.json Access-Control-Allow-Origin "*"
		header /openapi.json Cache-Control "public, max-age=300"
		header /robots.txt Access-Control-Allow-Origin "*"
		# Each section answers the way the root does: the page to a browser, the section's own brief to everything
		# else. The site shows an endpoint beside every section heading, and a name is not usable -- an agent that
		# follows it gets the browse page, a quarter of a megabyte of markup. This adds no API: every route the briefs
		# name already existed. /v2/ is deliberately untouched, because it is a protocol endpoint and OCI clients
		# depend on exactly what it returns.
		# A caller that asks for JSON by name gets the section descriptor: one fixed shape on all five
		# sections, naming how to enumerate this one, reach an item, fetch its bytes and check them.
		# Declared before @section_brief for the reason @agent precedes @arriving at the root: JSON also
		# fails the html test, and a caller that named a type should be given it.
		@section_json {
			path /models /models/ /registry /registry/ /spaces /spaces/ /buckets /buckets/ /docs/
			header Accept *application/json*
		}
		rewrite @section_json /{path.0}.json
		@section_brief {
			path /models /models/ /registry /registry/ /spaces /spaces/ /buckets /buckets/ /docs/
			not header Accept *text/html*
			not header Accept *application/json*
			not header User-Agent *bot*
			not header User-Agent *Bot*
			not header User-Agent *Slack*
			not header User-Agent *Twitter*
			not header User-Agent *Discord*
			not header User-Agent *facebookexternalhit*
		}
		rewrite @section_brief /{path.0}.md
		header /models* Vary Accept
		header /registry* Vary Accept
		header /spaces* Vary Accept
		header /buckets* Vary Accept
		header /docs/* Vary Accept
		header /models.md Access-Control-Allow-Origin "*"
		header /registry.md Access-Control-Allow-Origin "*"
		header /spaces.md Access-Control-Allow-Origin "*"
		header /buckets.md Access-Control-Allow-Origin "*"
		header /docs.md Access-Control-Allow-Origin "*"
		header /models.json Access-Control-Allow-Origin "*"
		header /registry.json Access-Control-Allow-Origin "*"
		header /spaces.json Access-Control-Allow-Origin "*"
		header /buckets.json Access-Control-Allow-Origin "*"
		header /docs.json Access-Control-Allow-Origin "*"
		# RFC 8288, so an agent finds the descriptor and the brief without parsing HTML.
		header /models* Link "</models.json>; rel=alternate, </models.md>; rel=describedby, </openapi.json>; rel=service-desc"
		header /registry* Link "</registry.json>; rel=alternate, </registry.md>; rel=describedby, </openapi.json>; rel=service-desc"
		header /spaces* Link "</spaces.json>; rel=alternate, </spaces.md>; rel=describedby, </openapi.json>; rel=service-desc"
		header /buckets* Link "</buckets.json>; rel=alternate, </buckets.md>; rel=describedby, </openapi.json>; rel=service-desc"
		header /docs/* Link "</docs.json>; rel=alternate, </docs.md>; rel=describedby, </openapi.json>; rel=service-desc"
		# Archived days are read by the browser from any origin and verified there.
		header /archive/* Access-Control-Allow-Origin "*"
		header /archive.json Access-Control-Allow-Origin "*"
		# Benchmark results, pushed into the website repository by the hologram benchmarks workflow; a data endpoint.
		header /benches/* Access-Control-Allow-Origin "*"
		reverse_proxy hub-site:8080
	}
}
