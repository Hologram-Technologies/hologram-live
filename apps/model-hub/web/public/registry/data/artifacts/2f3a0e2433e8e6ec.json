{"format":"hologram.registry.artifact/v1","id":"artifacthub/kyverno-policies/add-psa-labels","fetched":"2026-09-25T12:18:29.211Z","source":{"name":"Artifact Hub","api":"https://artifacthub.io/api/v1/packages/kyverno/kyverno-policies/add-psa-labels","page":"https://artifacthub.io/packages/kyverno/kyverno-policies/add-psa-labels"},"readme":"Pod Security Admission (PSA) can be controlled via the assignment of labels at the Namespace level which define the Pod Security Standard (PSS) profile in use and the action to take. If not using a cluster-wide configuration via an AdmissionConfiguration file, Namespaces must be explicitly labeled. This policy assigns the labels `pod-security.kubernetes.io/enforce=baseline` and `pod-security.kubernetes.io/warn=restricted` to all new Namespaces if those labels are not included.\n\nRefer to the documentation for more details on Kyverno annotations: https://artifacthub.io/docs/topics/annotations/kyverno/","readmeBase":"https://github.com/kyverno/policies","publisher":{"name":"Kyverno","url":"https://artifacthub.io/packages/search?org=kyverno","official":false,"verified":true,"cncf":true},"registered":null,"updated":"2023-04-10T23:21:22.000Z","categories":[],"keywords":["kyverno","Pod Security Admission","EKS Best Practices"],"license":null,"links":[{"name":"Kyverno Policies repository","url":"https://github.com/kyverno/policies"}],"maintainers":[],"stats":{"pulls":null,"stars":0,"subscriptions":0},"mediaTypes":[],"contentTypes":[],"storage":null,"tags":[{"name":"1.0.0","digest":"sha256:2c901e8fd195193f336eb91fed91e34530ad416174274199328a7aff4017c72d","pushed":"2023-04-10T23:21:22.000Z","size":null,"platforms":[],"mediaType":null,"status":null,"appVersion":null}],"tagsTotal":1,"security":null,"install":"```shell\nkubectl apply -f https://raw.githubusercontent.com/kyverno/policies/main/psa-mpol/add-psa-labels/add-psa-labels.yaml\n```","version":"1.0.0","appVersion":null,"containersImages":[],"contentUrl":null,"signed":false,"deprecated"