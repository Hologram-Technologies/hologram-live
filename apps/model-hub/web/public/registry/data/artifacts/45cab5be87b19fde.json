{"format":"hologram.registry.artifact/v1","id":"artifacthub/kyverno-policies/allowed-pod-priorities-cel","fetched":"2026-09-25T12:18:29.887Z","source":{"name":"Artifact Hub","api":"https://artifacthub.io/api/v1/packages/kyverno/kyverno-policies/allowed-pod-priorities-cel","page":"https://artifacthub.io/packages/kyverno/kyverno-policies/allowed-pod-priorities-cel"},"readme":"A Pod PriorityClass is used to provide a guarantee on the scheduling of a Pod relative to others. In certain cases where not all users in a cluster are trusted, a malicious user could create Pods at the highest possible priorities, causing other Pods to be evicted/not get scheduled. This policy checks the defined `priorityClassName` in a Pod spec to a dictionary of allowable PriorityClasses for the given Namespace stored in a ConfigMap. If the `priorityClassName` is not among them, the Pod is blocked.\n\nRefer to the documentation for more details on Kyverno annotations: https://artifacthub.io/docs/topics/annotations/kyverno/","readmeBase":"https://github.com/kyverno/policies","publisher":{"name":"Kyverno","url":"https://artifacthub.io/packages/search?org=kyverno","official":false,"verified":true,"cncf":true},"registered":null,"updated":"2024-03-19T17:20:47.000Z","categories":[],"keywords":["kyverno","Sample","CEL Expressions"],"license":null,"links":[{"name":"Kyverno Policies repository","url":"https://github.com/kyverno/policies"}],"maintainers":[],"stats":{"pulls":null,"stars":0,"subscriptions":0},"mediaTypes":[],"contentTypes":[],"storage":null,"tags":[{"name":"1.0.0","digest":"sha256:fc3abdb001c9cd666cc784d67eb584800a1a5ab357fbf3616dee2c5752e0f805","pushed":"2024-03-19T17:20:47.000Z","size":null,"platforms":[],"mediaType":null,"status":null,"appVersion":null}],"tagsTotal":1,"security":null,"install":"```shell\nkubectl apply -f https://raw.githubusercontent.com/kyverno/policies/main/other-cel/allowed-pod-priorities/allowed-pod-priorities.yaml\n```","version":"1.0.0","appVersion":null,"contain