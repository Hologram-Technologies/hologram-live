{"format":"hologram.registry.artifact/v1","id":"artifacthub/kyverno-policies/add-emptydir-sizelimit","fetched":"2026-09-25T12:18:28.399Z","source":{"name":"Artifact Hub","api":"https://artifacthub.io/api/v1/packages/kyverno/kyverno-policies/add-emptydir-sizelimit","page":"https://artifacthub.io/packages/kyverno/kyverno-policies/add-emptydir-sizelimit"},"readme":"When a Pod requests an emptyDir, by default it does not have a size limit which may allow it to consume excess or all of the space in the medium backing the volume. This can quickly overrun a Node and may result in a denial of service for other workloads. This policy adds a sizeLimit field to all Pods mounting emptyDir volumes, if not present, and sets it to 100Mi.\n\nRefer to the documentation for more details on Kyverno annotations: https://artifacthub.io/docs/topics/annotations/kyverno/","readmeBase":"https://github.com/kyverno/policies","publisher":{"name":"Kyverno","url":"https://artifacthub.io/packages/search?org=kyverno","official":false,"verified":true,"cncf":true},"registered":null,"updated":"2025-09-20T20:30:02.000Z","categories":[],"keywords":["kyverno","Other"],"license":null,"links":[{"name":"Kyverno Policies repository","url":"https://github.com/kyverno/policies"}],"maintainers":[],"stats":{"pulls":null,"stars":0,"subscriptions":0},"mediaTypes":[],"contentTypes":[],"storage":null,"tags":[{"name":"1.0.0","digest":"sha256:7f393eaa65141f29e6ca3b971c48932b9fe2228145adcc366c2de49502952946","pushed":"2025-09-20T20:30:02.000Z","size":null,"platforms":[],"mediaType":null,"status":null,"appVersion":null}],"tagsTotal":1,"security":null,"install":"```shell\nkubectl apply -f https://raw.githubusercontent.com/kyverno/policies/main/other-mpol/add-emptydir-sizelimit/add-emptydir-sizelimit.yaml\n```","version":"1.0.0","appVersion":null,"containersImages":[],"contentUrl":null,"signed":false,"deprecated":false,"repo":{"name":"kyverno-policies","url":"https://github.com/kyverno/policies","kind":"Kyverno policy"},