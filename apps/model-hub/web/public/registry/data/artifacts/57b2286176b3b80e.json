{"format":"hologram.registry.artifact/v1","id":"artifacthub/kyverno-policies/advanced-restrict-image-registries-cel","fetched":"2026-09-25T12:18:29.590Z","source":{"name":"Artifact Hub","api":"https://artifacthub.io/api/v1/packages/kyverno/kyverno-policies/advanced-restrict-image-registries-cel","page":"https://artifacthub.io/packages/kyverno/kyverno-policies/advanced-restrict-image-registries-cel"},"readme":"In instances where a ClusterPolicy defines all the approved image registries is insufficient, more granular control may be needed to set permitted registries, especially in multi-tenant use cases where some registries may be based on the Namespace. This policy shows an advanced version of the Restrict Image Registries policy which gets a global approved registry from a ConfigMap and, based upon an annotation at the Namespace level, gets the registry approved for that Namespace.\n\nRefer to the documentation for more details on Kyverno annotations: https://artifacthub.io/docs/topics/annotations/kyverno/","readmeBase":"https://github.com/kyverno/policies","publisher":{"name":"Kyverno","url":"https://artifacthub.io/packages/search?org=kyverno","official":false,"verified":true,"cncf":true},"registered":null,"updated":"2024-04-21T11:03:06.000Z","categories":[],"keywords":["kyverno","Other","CEL Expressions"],"license":null,"links":[{"name":"Kyverno Policies repository","url":"https://github.com/kyverno/policies"}],"maintainers":[],"stats":{"pulls":null,"stars":0,"subscriptions":0},"mediaTypes":[],"contentTypes":[],"storage":null,"tags":[{"name":"1.0.0","digest":"sha256:affd33e654245f8e62ad872c2ce58b60776ab9b472123c19c6524c1790be414b","pushed":"2024-04-21T11:03:06.000Z","size":null,"platforms":[],"mediaType":null,"status":null,"appVersion":null}],"tagsTotal":1,"security":null,"install":"```shell\nkubectl apply -f https://raw.githubusercontent.com/kyverno/policies/main/other-cel/advanced-restrict-image-registries/advanced-restrict-image-registries.yaml\n```","version"