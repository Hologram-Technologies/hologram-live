{"format":"hologram.registry.artifact/v1","id":"artifacthub/kyverno-policies/advertise-node-extended-resources","fetched":"2026-09-25T12:18:29.642Z","source":{"name":"Artifact Hub","api":"https://artifacthub.io/api/v1/packages/kyverno/kyverno-policies/advertise-node-extended-resources","page":"https://artifacthub.io/packages/kyverno/kyverno-policies/advertise-node-extended-resources"},"readme":"Kubernetes Nodes, in addition to standard compute resources like CPU and memory, may offer extended resources such as FPGAs and GPUs, both of which can be defined per custom design. These extended resources are advertised in the `status` object of a Node. This policy, functional only starting in Kyverno 1.9, adds the extended resource `example.com/dongle` with a value/capacity of `2` to Kubernetes Nodes.\n\nRefer to the documentation for more details on Kyverno annotations: https://artifacthub.io/docs/topics/annotations/kyverno/","readmeBase":"https://github.com/kyverno/policies","publisher":{"name":"Kyverno","url":"https://artifacthub.io/packages/search?org=kyverno","official":false,"verified":true,"cncf":true},"registered":null,"updated":"2023-04-10T20:30:03.000Z","categories":[],"keywords":["kyverno","Other"],"license":null,"links":[{"name":"Kyverno Policies repository","url":"https://github.com/kyverno/policies"}],"maintainers":[],"stats":{"pulls":null,"stars":0,"subscriptions":0},"mediaTypes":[],"contentTypes":[],"storage":null,"tags":[{"name":"1.0.0","digest":"sha256:b065619c0a200913b2bc2d420f5bfb8f145c54d7f04c302c6be5847ada96872c","pushed":"2023-04-10T20:30:03.000Z","size":null,"platforms":[],"mediaType":null,"status":null,"appVersion":null}],"tagsTotal":1,"security":null,"install":"```shell\nkubectl apply -f https://raw.githubusercontent.com/kyverno/policies/main/other/advertise-node-extended-resources/advertise-node-extended-resources.yaml\n```","version":"1.0.0","appVersion":null,"containersImages":[],"contentUrl":null,"signed":false,"deprecated":false,"repo":{"name