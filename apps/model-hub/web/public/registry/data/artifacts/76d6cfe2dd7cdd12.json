{"format":"hologram.registry.artifact/v1","id":"artifacthub/kyverno-policies/allowed-pod-priorities-vpol","fetched":"2026-09-25T12:18:29.988Z","source":{"name":"Artifact Hub","api":"https://artifacthub.io/api/v1/packages/kyverno/kyverno-policies/allowed-pod-priorities-vpol","page":"https://artifacthub.io/packages/kyverno/kyverno-policies/allowed-pod-priorities-vpol"},"readme":"A Pod PriorityClass is used to provide a guarantee on the scheduling of a Pod relative to others. In certain cases where not all users in a cluster are trusted, a malicious user could create Pods at the highest possible priorities, causing other Pods to be evicted/not get scheduled. This policy checks the defined `priorityClassName` in a Pod spec to a dictionary of allowable PriorityClasses for the given Namespace stored in a ConfigMap. If the `priorityClassName` is not among them, the Pod is blocked.\n\nRefer to the documentation for more details on Kyverno annotations: https://artifacthub.io/docs/topics/annotations/kyverno/","readmeBase":"https://github.com/kyverno/policies","publisher":{"name":"Kyverno","url":"https://artifacthub.io/packages/search?org=kyverno","official":false,"verified":true,"cncf":true},"registered":null,"updated":"2025-05-11T17:46:12.000Z","categories":[],"keywords":["kyverno","Sample","ValidatingPolicy"],"license":null,"links":[{"name":"Kyverno Policies repository","url":"https://github.com/kyverno/policies"}],"maintainers":[],"stats":{"pulls":null,"stars":0,"subscriptions":0},"mediaTypes":[],"contentTypes":[],"storage":null,"tags":[{"name":"1.0.0","digest":"sha256:67324ef06e08c4ca43d9700b2de674833ad3489510dbb6cf186b2061a5762a1f","pushed":"2025-05-11T17:46:12.000Z","size":null,"platforms":[],"mediaType":null,"status":null,"appVersion":null}],"tagsTotal":1,"security":null,"install":"```shell\nkubectl apply -f https://raw.githubusercontent.com/kyverno/policies/main/other-vpol/allowed-pod-priorities/allowed-pod-priorities.yaml\n```","version":"1.0.0","appVersion":null,"co