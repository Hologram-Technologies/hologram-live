{"format":"hologram.registry.artifact/v1","id":"artifacthub/krew-index/node-shell","fetched":"2026-09-25T12:17:03.401Z","source":{"name":"Artifact Hub","api":"https://artifacthub.io/api/v1/packages/krew/krew-index/node-shell","page":"https://artifacthub.io/packages/krew/krew-index/node-shell"},"readme":"Start a root shell in the node's host OS running.\nYou need to be able to start privileged containers for that.\n\nUsage:\n\n  Get standard bash shell:\n  $ kubectl node-shell <node>\n  \n  Use X-mode (mount /host, and do not enter host namespace)\n  $ kubectl node-shell -x <node>\n\n  Execute custom command:\n  $ kubectl node-shell <node> -- echo 123\n  \n  Use stdin:\n  $ cat /etc/passwd | kubectl node-shell <node> -- sh -c 'cat > /tmp/passwd'\n  \n  Run oneliner script:\n  $ kubectl node-shell <node> -- sh -c 'cat /tmp/passwd; rm -f /tmp/passwd'","readmeBase":"https://github.com/kvaps/kubectl-node-shell","publisher":{"name":"Artifact Hub","url":"https://artifacthub.io/packages/search?org=artifacthub","official":false,"verified":false,"cncf":false},"registered":null,"updated":"2024-11-25T20:31:00.000Z","categories":["Networking"],"keywords":["kubernetes","kubectl","plugin"],"license":null,"links":[{"name":"home","url":"https://github.com/kvaps/kubectl-node-shell"},{"name":"Krew index repository","url":"https://github.com/kubernetes-sigs/krew-index"}],"maintainers":[],"stats":{"pulls":null,"stars":1,"subscriptions":0},"mediaTypes":[],"contentTypes":[],"storage":null,"tags":[{"name":"1.11.0","digest":null,"pushed":"2024-11-25T20:31:00.000Z","size":null,"platforms":[],"mediaType":null,"status":null,"appVersion":null}],"tagsTotal":1,"security":null,"install":null,"version":"1.11.0","appVersion":null,"containersImages":[],"contentUrl":null,"signed":false,"deprecated":false,"repo":{"name":"krew-index","url":"https://github.com/kubernetes-sigs/krew-index","kind":"Kubectl plugin"},"logo":null}