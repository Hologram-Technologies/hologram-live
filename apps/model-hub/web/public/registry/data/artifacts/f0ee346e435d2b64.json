{"format":"hologram.registry.artifact/v1","id":"artifacthub/kyverno-policies/add-certificates-volume","fetched":"2026-09-25T12:18:28.349Z","source":{"name":"Artifact Hub","api":"https://artifacthub.io/api/v1/packages/kyverno/kyverno-policies/add-certificates-volume","page":"https://artifacthub.io/packages/kyverno/kyverno-policies/add-certificates-volume"},"readme":"In some cases you would need to trust custom CA certificates for all the containers of a Pod. It makes sense to be in a ConfigMap so that you can automount them by only setting an annotation. This policy adds a volume to all containers in a Pod containing the certificate if the annotation called `inject-certs` with value `enabled` is found.\n\nRefer to the documentation for more details on Kyverno annotations: https://artifacthub.io/docs/topics/annotations/kyverno/","readmeBase":"https://github.com/kyverno/policies","publisher":{"name":"Kyverno","url":"https://artifacthub.io/packages/search?org=kyverno","official":false,"verified":true,"cncf":true},"registered":null,"updated":"2025-09-20T20:30:02.000Z","categories":[],"keywords":["kyverno","Sample"],"license":null,"links":[{"name":"Kyverno Policies repository","url":"https://github.com/kyverno/policies"}],"maintainers":[],"stats":{"pulls":null,"stars":0,"subscriptions":0},"mediaTypes":[],"contentTypes":[],"storage":null,"tags":[{"name":"1.0.0","digest":"sha256:bd9688d51cf92ff4b1ce1a0a986c8b7cc0961398cdf72abf2b66d3c25ab0768d","pushed":"2025-09-20T20:30:02.000Z","size":null,"platforms":[],"mediaType":null,"status":null,"appVersion":null}],"tagsTotal":1,"security":null,"install":"```shell\nkubectl apply -f https://raw.githubusercontent.com/kyverno/policies/main/other-mpol/add-certificates-volume/add-certificates-volume.yaml\n```","version":"1.0.0","appVersion":null,"containersImages":[],"contentUrl":null,"signed":false,"deprecated":false,"repo":{"name":"kyverno-policies","url":"https://github.com/kyverno/policies","kind":"Kyverno policy"},"logo":null}