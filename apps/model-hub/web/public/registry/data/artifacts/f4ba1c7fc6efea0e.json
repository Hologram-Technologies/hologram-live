icrosoft.com/en-us/azure/machine-learning/how-to-inference-server-http?view=azureml-api-2)\n\n## Support\n- [Troubleshooting Guide](https://docs.microsoft.com/azure/machine-learning/how-to-troubleshoot-prebuilt-docker-image-inference)\n\n## License\n\nLegal Notice: [Container License Information](https://aka.ms/mcr/osslegalnotice). By downloading these images, you agree to the terms of the license agreement.","readmeBase":null,"publisher":{"name":"Microsoft","url":"https://mcr.microsoft.com/","official":true,"verified":true},"registered":null,"updated":"2024-01-31T19:35:39.9572648+00:00","categories":[],"keywords":[],"license":"MIT","links":[],"maintainers":[],"stats":{"pulls":null,"pullsText":"146K+","stars":null},"mediaTypes":[],"contentTypes":[],"storage":null,"tags":[{"name":"20240122.v1","digest":"sha256:5ca6c26f351605a2d50f6fe7a6744bb3c5d5ed1346cea4aa88d724de9e4c8537","pushed":"2024-01-22T18:07:13.0000000+00:00","size":11767,"platforms":["linux/amd64"],"mediaType":"application/vnd.docker.distribution.manifest.v2+json","status":null},{"name":"20240108.v1","digest":"sha256:5ca6c26f351605a2d50f6fe7a6744bb3c5d5ed1346cea4aa88d724de9e4c8537","pushed":"2024-01-08T22:19:00.0000000+00:00","size":11767,"platforms":["linux/amd64"],"mediaType":"application/vnd.docker.distribution.manifest.v2+json","status":null},{"name":"20240101.v1","digest":"sha256:5ca6c26f351605a2d50f6fe7a6744bb3c5d5ed1346cea4aa88d724de9e4c8537","pushed":"2024-01-02T17:12:01.0000000+00:00","size":11767,"platforms":["linux/amd64"],"mediaType":"application/vnd.docker.distribution.manifest.v2+json","status":null},{"name":"20231218.v2","digest":"sha256:5ca6c26f351605a2d50f6fe7a6744bb3c5d5ed1346cea4aa88d724de9e4c8537","pushed":"2023-12-19T03:21:18.0000000+00:00","size":11767,"platforms":["linux/amd64"],"mediaType":"application/vnd.docker.distribution.manifest.v2+json","status":null},{"name":"20231207.v2","digest":"sha256:5ca6c26f351605a2d50f6fe7a6744bb3c5d5ed1346cea4aa88d724de9e4c8537","pushed":"2023-12-08T