{"format":"hologram.registry.artifact/v1","id":"artifacthub/kyverno-policies/add-linkerd-policy-annotation","fetched":"2026-09-25T12:18:28.789Z","source":{"name":"Artifact Hub","api":"https://artifacthub.io/api/v1/packages/kyverno/kyverno-policies/add-linkerd-policy-annotation","page":"https://artifacthub.io/packages/kyverno/kyverno-policies/add-linkerd-policy-annotation"},"readme":"Linkerd will, by default, allow all incoming traffic to Pods in the mesh including that from outside the cluster network. In many cases, this default needs to be changed to deny all traffic so it may be selectively opened using Linkerd policy objects. This policy sets the annotation `config.linkerd.io/default-inbound-policy` to `deny`, if not present, for new Namespaces. It can be customized with exclusions to more tightly control its application.\n\nRefer to the documentation for more details on Kyverno annotations: https://artifacthub.io/docs/topics/annotations/kyverno/","readmeBase":"https://github.com/kyverno/policies","publisher":{"name":"Kyverno","url":"https://artifacthub.io/packages/search?org=kyverno","official":false,"verified":true,"cncf":true},"registered":null,"updated":"2023-04-10T20:19:58.000Z","categories":[],"keywords":["kyverno","Linkerd"],"license":null,"links":[{"name":"Kyverno Policies repository","url":"https://github.com/kyverno/policies"}],"maintainers":[],"stats":{"pulls":null,"stars":0,"subscriptions":0},"mediaTypes":[],"contentTypes":[],"storage":null,"tags":[{"name":"1.0.0","digest":"sha256:1c258570deeff0c7f8354d5d5973168651942b01dc37b7ee9a573ca83048e191","pushed":"2023-04-10T20:19:58.000Z","size":null,"platforms":[],"mediaType":null,"status":null,"appVersion":null}],"tagsTotal":1,"security":null,"install":"```shell\nkubectl apply -f https://raw.githubusercontent.com/kyverno/policies/main/linkerd-mpol/add-linkerd-policy-annotation/add-linkerd-policy-annotation.yaml\n```","version":"1.0.0","appVersion":null,"containersImages":[],"contentUrl":null,"signed":false