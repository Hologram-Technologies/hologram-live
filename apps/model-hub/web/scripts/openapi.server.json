{
 "openapi": "3.1.0",
 "info": {
  "title": "Hologram Live API",
  "description": "Extensible local and remote module host for Hologram",
  "license": {
   "name": "MIT OR Apache-2.0",
   "identifier": "MIT OR Apache-2.0"
  },
  "version": "1.0.0"
 },
 "paths": {
  "/api/v1/capabilities": {
   "get": {
    "tags": [],
    "operationId": "capabilities",
    "responses": {
     "200": {
      "description": "",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/CapabilityManifest"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/modules": {
   "get": {
    "tags": [],
    "operationId": "list_modules",
    "responses": {
     "200": {
      "description": "",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/ModuleInfo"
         }
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/objects": {
   "get": {
    "tags": [],
    "operationId": "list_objects",
    "responses": {
     "200": {
      "description": "",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/ObjectMetadata"
         }
        }
       }
      }
     }
    }
   },
   "post": {
    "tags": [],
    "operationId": "put_object",
    "parameters": [
     {
      "name": "content-type",
      "in": "header",
      "description": "Stored media type",
      "required": false,
      "schema": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     {
      "name": "x-hologram-kind",
      "in": "header",
      "description": "Object kind; defaults to file",
      "required": false,
      "schema": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     {
      "name": "x-hologram-filename",
      "in": "header",
      "description": "Original filename",
      "required": false,
      "schema": {
       "type": [
        "string",
        "null"
       ]
      }
     }
    ],
    "requestBody": {
     "content": {
      "application/octet-stream": {
       "schema": {
        "type": "array",
        "items": {
         "type": "integer",
         "format": "int32",
         "minimum": 0
        }
       }
      }
     },
     "required": true
    },
    "responses": {
     "201": {
      "description": "",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ObjectMetadata"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/objects/search": {
   "get": {
    "tags": [],
    "operationId": "search_objects",
    "parameters": [
     {
      "name": "kind",
      "in": "query",
      "description": "Exact object kind",
      "required": false,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "media_type",
      "in": "query",
      "description": "Exact media type",
      "required": false,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "filename_contains",
      "in": "query",
      "description": "Filename substring",
      "required": false,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "min_size",
      "in": "query",
      "description": "Minimum size in bytes",
      "required": false,
      "schema": {
       "type": "integer",
       "format": "int64",
       "minimum": 0
      }
     },
     {
      "name": "max_size",
      "in": "query",
      "description": "Maximum size in bytes",
      "required": false,
      "schema": {
       "type": "integer",
       "format": "int64",
       "minimum": 0
      }
     },
     {
      "name": "created_after_millis",
      "in": "query",
      "description": "Exclusive lower bound",
      "required": false,
      "schema": {
       "type": "integer",
       "format": "int64",
       "minimum": 0
      }
     },
     {
      "name": "created_before_millis",
      "in": "query",
      "description": "Exclusive upper bound",
      "required": false,
      "schema": {
       "type": "integer",
       "format": "int64",
       "minimum": 0
      }
     },
     {
      "name": "limit",
      "in": "query",
      "description": "Page size; defaults to 100, clamped to 1000",
      "required": false,
      "schema": {
       "type": "integer",
       "format": "int32",
       "minimum": 0
      }
     },
     {
      "name": "cursor",
      "in": "query",
      "description": "Opaque cursor from a previous page",
      "required": false,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ObjectPage"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/objects/{id}": {
   "get": {
    "tags": [],
    "operationId": "get_object",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "description": "Content-addressed object ID",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Raw object bytes",
      "content": {
       "application/octet-stream": {}
      }
     },
     "404": {
      "description": "Object not found"
     }
    }
   }
  },
  "/healthz": {
   "get": {
    "tags": [],
    "operationId": "healthz",
    "responses": {
     "200": {
      "description": "",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HealthResponse"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "ApiError": {
    "type": "object",
    "required": [
     "code",
     "message"
    ],
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     }
    }
   },
   "CapabilityManifest": {
    "type": "object",
    "required": [
     "protocol_version",
     "server_version",
     "server_id",
     "role",
     "operations",
     "modules",
     "maximum_message_bytes"
    ],
    "properties": {
     "maximum_message_bytes": {
      "type": "integer",
      "format": "int32",
      "minimum": 0
     },
     "modules": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/ModuleInfo"
      }
     },
     "operations": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/OperationInfo"
      }
     },
     "protocol_version": {
      "type": "integer",
      "format": "int32",
      "minimum": 0
     },
     "role": {
      "type": "string"
     },
     "server_id": {
      "type": "string"
     },
     "server_version": {
      "type": "string"
     }
    }
   },
   "HealthResponse": {
    "type": "object",
    "required": [
     "status",
     "version",
     "role",
     "modules_ready"
    ],
    "properties": {
     "modules_ready": {
      "type": "integer",
      "minimum": 0
     },
     "role": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "version": {
      "type": "string"
     }
    }
   },
   "ModuleInfo": {
    "type": "object",
    "required": [
     "id",
     "name",
     "version",
     "state",
     "dependencies",
     "operations"
    ],
    "properties": {
     "dependencies": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "operations": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "state": {
      "type": "string"
     },
     "version": {
      "type": "string"
     }
    }
   },
   "ObjectMetadata": {
    "type": "object",
    "required": [
     "id",
     "kind",
     "media_type",
     "size",
     "created_at_millis"
    ],
    "properties": {
     "created_at_millis": {
      "type": "integer",
      "format": "int64",
      "minimum": 0
     },
     "filename": {
      "type": [
       "string",
       "null"
      ]
     },
     "id": {
      "type": "string"
     },
     "kind": {
      "type": "string"
     },
     "media_type": {
      "type": "string"
     },
     "size": {
      "type": "integer",
      "format": "int64",
      "minimum": 0
     }
    }
   },
   "ObjectPage": {
    "type": "object",
    "description": "One page of search results.",
    "required": [
     "objects",
     "truncated"
    ],
    "properties": {
     "next_cursor": {
      "type": [
       "string",
       "null"
      ],
      "description": "Absent when the walk reached the end of the result set."
     },
     "objects": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/ObjectMetadata"
      }
     },
     "truncated": {
      "type": "boolean",
      "description": "True when a provider-side scan bound stopped the walk before `limit`\nwas satisfied. A capped result is never presented as a complete one."
     }
    }
   },
   "ObjectQuery": {
    "type": "object",
    "description": "A search over stored objects.\n\nEvery field is an independent conjunctive filter; `None` means \"do not\nconstrain\". Ordering is ascending by object id, identically for every\nprovider: a remote tag listing arrives in lexical order, and imposing a\ntime ordering on it would mean enumerating everything before returning the\nfirst page.",
    "properties": {
     "created_after_millis": {
      "type": [
       "integer",
       "null"
      ],
      "format": "int64",
      "minimum": 0
     },
     "created_before_millis": {
      "type": [
       "integer",
       "null"
      ],
      "format": "int64",
      "minimum": 0
     },
     "cursor": {
      "type": [
       "string",
       "null"
      ],
      "description": "Opaque, and valid only for the provider that issued it. A structured\ncursor would leak provider internals into a public API and stop either\nside changing independently."
     },
     "filename_contains": {
      "type": [
       "string",
       "null"
      ]
     },
     "kind": {
      "type": [
       "string",
       "null"
      ]
     },
     "limit": {
      "type": "integer",
      "format": "int32",
      "minimum": 0
     },
     "max_size": {
      "type": [
       "integer",
       "null"
      ],
      "format": "int64",
      "minimum": 0
     },
     "media_type": {
      "type": [
       "string",
       "null"
      ]
     },
     "min_size": {
      "type": [
       "integer",
       "null"
      ],
      "format": "int64",
      "minimum": 0
     }
    }
   },
   "OperationInfo": {
    "type": "object",
    "required": [
     "id",
     "kind",
     "fallback_safe_before_dispatch"
    ],
    "properties": {
     "fallback_safe_before_dispatch": {
      "type": "boolean"
     },
     "id": {
      "type": "string"
     },
     "kind": {
      "$ref": "#/components/schemas/OperationKind"
     }
    }
   },
   "OperationKind": {
    "type": "string",
    "enum": [
     "read",
     "mutation",
     "stream"
    ]
   }
  }
 },
 "tags": [
  {
   "name": "system",
   "description": "Hologram Live system endpoints"
  },
  {
   "name": "system",
   "description": "Host capabilities and module discovery"
  },
  {
   "name": "kappa-registry",
   "description": "Content-addressed registry provider"
  }
 ]
}
