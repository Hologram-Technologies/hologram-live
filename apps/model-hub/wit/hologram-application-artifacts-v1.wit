package hologram:application-artifacts@1.0.0;

/// PROPOSED by ADR 023. The Component guest interface with mediated artifact operations.
interface guest {
  enum error-code {
    invalid-input,
    failed,
  }

  record guest-error {
    code: error-code,
    message: string,
  }

  run: func(input: list<u8>) -> result<list<u8>, guest-error>;
}

world application {
  import hologram:host/artifacts@1.0.0;
  export guest;
}
