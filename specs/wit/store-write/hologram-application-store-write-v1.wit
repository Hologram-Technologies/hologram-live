package hologram:application-store-write@1.0.0;

/// The Hologram Component Model v1 guest interface with mediated object writes.
interface guest {
  enum error-code {
    invalid-input,
    failed,
  }

  record guest-error {
    code: error-code,
    message: string,
  }

  run: func(input: list<u8>) -> result<list<u8>, guest-error>;
}

world application {
  import hologram:host/store-write@1.0.0;
  export guest;
}
