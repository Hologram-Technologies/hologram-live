+fn normalize_tree_timestamps(path: &Path) -> Result<()> {
+    if path.is_symlink() {
+        return Err(anyhow!(
+            "refusing to normalize symlink in deterministic component input: {}",
+            path.display()
+        ));
+    }
+    if path.is_dir() {
+        let mut entries = fs::read_dir(path)?.collect::<std::io::Result<Vec<_>>>()?;
+        entries.sort_by_key(std::fs::DirEntry::file_name);
+        for entry in entries {
+            normalize_tree_timestamps(&entry.path())?;
+        }
+    }
+    let epoch = filetime::FileTime::from_unix_time(0, 0);
+    filetime::set_file_times(path, epoch, epoch)?;
+    Ok(())
+}
