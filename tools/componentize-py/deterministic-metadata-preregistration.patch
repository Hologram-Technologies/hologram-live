+#[cfg(feature = "deterministic-metadata-hashes")]
+fn register_preopened_tree(
+    hashes: &mut DeterministicMetadataHashes,
+    dir: &cap_std::fs::Dir,
+) -> std::io::Result<()> {
+    let metadata = dir.dir_metadata()?;
+    let identity = (metadata.dev(), metadata.ino());
+    hashes.identities.entry(identity).or_insert_with(|| {
+        hashes.next = hashes.next.checked_add(1).expect("guest identity overflow");
+        MetadataHashValue::from_guest_identity(hashes.next)
+    });
+
+    let mut entries = dir
+        .entries()?
+        .map(|entry| {
+            let entry = entry?;
+            Ok((entry.file_name(), entry))
+        })
+        .collect::<std::io::Result<Vec<_>>>()?;
+    entries.sort_by(|left, right| left.0.cmp(&right.0));
+    for (name, entry) in entries {
+        let metadata = entry.metadata()?;
+        let is_dir = metadata.is_dir();
+        let identity = (metadata.dev(), metadata.ino());
+        hashes.identities.entry(identity).or_insert_with(|| {
+            hashes.next = hashes.next.checked_add(1).expect("guest identity overflow");
+            MetadataHashValue::from_guest_identity(hashes.next)
+        });
+        if is_dir {
+            register_preopened_tree(hashes, &dir.open_dir(name)?)?;
+        }
+    }
+    Ok(())
+}
