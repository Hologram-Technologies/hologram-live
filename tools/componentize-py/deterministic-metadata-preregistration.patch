+#[cfg(all(test, feature = "deterministic-metadata-hashes"))]
+mod deterministic_metadata_tests {
+    use super::{DeterministicMetadataHashes, register_preopened_tree};
+    use cap_fs_ext::MetadataExt as _;
+    use std::fs;
+
+    fn registered_identities(creation_order: &[&str]) -> Vec<u64> {
+        let temporary = tempfile::tempdir().expect("temporary tree");
+        for path in creation_order {
+            let path = temporary.path().join(path);
+            if let Some(parent) = path.parent() {
+                fs::create_dir_all(parent).expect("create parent");
+            }
+            fs::write(path, b"content").expect("write file");
+        }
+
+        let dir =
+            cap_std::fs::Dir::open_ambient_dir(temporary.path(), cap_std::ambient_authority())
+                .expect("open tree");
+        let mut hashes = DeterministicMetadataHashes::default();
+        register_preopened_tree(&mut hashes, &dir).expect("register tree");
+
+        [".", "a", "b", "nested", "nested/c"]
+            .into_iter()
+            .map(|path| {
+                let metadata = if path == "." {
+                    dir.dir_metadata().expect("root metadata")
+                } else {
+                    dir.metadata(path).expect("entry metadata")
+                };
+                hashes.identities[&(metadata.dev(), metadata.ino())].lower
+            })
+            .collect()
+    }
+
+    #[test]
+    fn preopened_tree_identities_ignore_host_creation_order() {
+        let forward = registered_identities(&["a", "b", "nested/c"]);
+        let reverse = registered_identities(&["nested/c", "b", "a"]);
+        assert_eq!(forward, vec![1, 2, 3, 4, 5]);
+        assert_eq!(reverse, forward);
+    }
+}
