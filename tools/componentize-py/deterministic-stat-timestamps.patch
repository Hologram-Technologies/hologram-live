@@ -1349,4 +1365,29 @@ mod deterministic_metadata_tests {
         assert_eq!(forward, vec![1, 2, 3, 4, 5]);
         assert_eq!(reverse, forward);
     }
+
+    #[test]
+    fn descriptor_stat_timestamps_are_epoch_normalized() {
+        let temporary = tempfile::tempdir().expect("temporary tree");
+        fs::write(temporary.path().join("file"), b"content").expect("write file");
+        let dir =
+            cap_std::fs::Dir::open_ambient_dir(temporary.path(), cap_std::ambient_authority())
+                .expect("open tree");
+        let file = dir.open("file").expect("open file");
+        let stat = DescriptorStat::from(file.metadata().expect("file metadata"));
+
+        assert!(stat.data_access_timestamp.is_some());
+        assert!(stat.data_modification_timestamp.is_some());
+        for timestamp in [
+            stat.data_access_timestamp,
+            stat.data_modification_timestamp,
+            stat.status_change_timestamp,
+        ]
+        .into_iter()
+        .flatten()
+        {
+            assert_eq!(timestamp.seconds, 0);
+            assert_eq!(timestamp.nanoseconds, 0);
+        }
+    }
 }
